<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android uniquement (voir docs/INSTALLATION.md). -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>MediQueue.Consultant</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>MediQueue Consultant</ApplicationTitle>
		<ApplicationId>com.mediqueue.consultant</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- ICÔNE : remplacez les deux SVG (voir docs/CONSULTANT.md, § Images et icône) -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2F6F9E" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2F6F9E" BaseSize="128,128" />

		<MauiImage Include="Resources\Images\*.svg;Resources\Images\*.png;Resources\Images\*.jpg;Resources\Images\*.jpeg" />
		<MauiFont Include="Resources\Fonts\*.ttf;Resources\Fonts\*.otf" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- Pas de paquet de scan ici : l'app Consultant n'utilise pas la caméra. -->
	</ItemGroup>

</Project>
